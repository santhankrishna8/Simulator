# Copy to .env.local for local development, or set these in Vercel's project settings.
# Without them the app still works: Arduino sketches that match a built-in example run from a
# bundled program, and anything you edit shows "no compile service is connected".

# Where compile-service/ is running, e.g. https://simulator-compile.onrender.com
COMPILE_SERVICE_URL=

# Must match COMPILE_TOKEN on the compile service (16+ characters).
COMPILE_SERVICE_TOKEN=

# The AI tutor. Without a key the tutor shows a friendly "not switched on" message.
# Keep this in Vercel's environment variables only; it is never sent to the browser.
OPENAI_API_KEY=
# Optional: which chat model answers (default gpt-4o-mini).
OPENAI_MODEL=
